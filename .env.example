# FixPix Backend Environment Variables
# Copy this file to .env and update values as needed

# Django Settings
DEBUG=True
SECRET_KEY=your_django_secret_key
ALLOWED_HOSTS=localhost 127.0.0.1

# CORS - Frontend URLs allowed to access API
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://localhost:3000

# Database (optional - uses SQLite by default)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Storage Provider (optional - uses local by default)
# Options: local, s3, cloudinary
# STORAGE_PROVIDER=local

# AWS S3 (if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Cloudinary (if STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Celery (optional - for async processing)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI News
NEWS_API_KEY=your_news_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_MODEL_NAME=llama-3.3-70b-versatile
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

GNEWS_API_KEY=your_gnews_api_key
NEWSDATA_API_KEY=your_newsdata_api_key
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_KNOWLEDGE_GRAPH_API_KEY=your_google_knowledge_graph_api_key
OPTIIC_API_KEY=your_optiic_api_key

OPENROUTER_API_KEY=your_openrouter_api_key
PHOTOROOM_API_KEY=your_photoroom_api_key
PHOTOROOM_SANDBOX=False
